{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.reduce.js\";\nexport default {\n  name: \"CheckoutPage\",\n  data() {\n    return {\n      cart: [],\n      totalPrice: 0,\n      customer: {\n        name: \"\",\n        gender: \"male\",\n        address: \"\",\n        note: \"\"\n      },\n      showDialog: false\n    };\n  },\n  created() {\n    const storedCart = localStorage.getItem(\"cart\");\n    if (storedCart) {\n      this.cart = JSON.parse(storedCart);\n    }\n    this.totalPrice = this.cart.reduce((sum, item) => sum + item.price * item.quantity, 0);\n  },\n  methods: {\n    formatPrice(value) {\n      return new Intl.NumberFormat(\"vi-VN\", {\n        style: \"currency\",\n        currency: \"VND\"\n      }).format(value);\n    },\n    showConfirmDialog() {\n      this.showDialog = true;\n    },\n    closeDialog() {\n      this.showDialog = false;\n    },\n    placeOrder() {\n      if (!this.customer.name || !this.customer.address) {\n        alert(\"Vui lòng nhập đầy đủ thông tin!\");\n        return;\n      }\n      const orderData = {\n        customer: this.customer,\n        cart: this.cart,\n        totalPrice: this.totalPrice,\n        orderDate: new Date().toLocaleString()\n      };\n      console.log(\"Đơn hàng:\", orderData);\n      alert(\"Đơn hàng đã được đặt thành công!\");\n      localStorage.removeItem(\"cart\");\n      localStorage.removeItem(\"totalPrice\");\n      this.cart = [];\n      this.totalPrice = 0;\n      this.showDialog = false;\n    }\n  }\n};","map":{"version":3,"names":["name","data","cart","totalPrice","customer","gender","address","note","showDialog","created","storedCart","localStorage","getItem","JSON","parse","reduce","sum","item","price","quantity","methods","formatPrice","value","Intl","NumberFormat","style","currency","format","showConfirmDialog","closeDialog","placeOrder","alert","orderData","orderDate","Date","toLocaleString","console","log","removeItem"],"sources":["D:\\Du_An\\BanHang_ThietBiDienThu\\QLBH_Application\\src\\views\\SearchForProducts\\CheckOutPay.vue"],"sourcesContent":["<template>\r\n    <div class=\"row d-flex\" style=\"padding-left: 70px; padding-right: \">\r\n      <h3 style=\"text-align: center\">Thông tin thanh toán</h3>\r\n      <div class=\"profile col-lg-5 col-9\">\r\n        <div class=\"inputname\">\r\n          <label for=\"name\">Họ và tên</label>\r\n          <input\r\n            v-model=\"customer.name\"\r\n            type=\"text\"\r\n            id=\"name\"\r\n            placeholder=\"Nhập họ và tên\"\r\n          />\r\n        </div>\r\n        <div class=\"inputphone\">\r\n          <label for=\"phone\">Số điện thoại</label>\r\n          <input\r\n            v-model=\"customer.phone\"\r\n            type=\"text\"\r\n            id=\"phone\"\r\n            placeholder=\"Nhập số điện thoại\"\r\n          />\r\n        </div>\r\n        <div class=\"grener\">\r\n          <label for=\"grener\">Giới tính</label>\r\n          <select v-model=\"customer.gender\" name=\"grener\" id=\"grener\">\r\n            <option value=\"male\">Nam</option>\r\n            <option value=\"female\">Nữ</option>\r\n          </select>\r\n        </div>\r\n        <div class=\"inputaddress\">\r\n          <label for=\"address\">Địa chỉ</label>\r\n          <input\r\n            v-model=\"customer.address\"\r\n            type=\"text\"\r\n            id=\"address\"\r\n            placeholder=\"Nhập địa chỉ\"\r\n          />\r\n        </div>\r\n        <div class=\"inputnote\">\r\n          <label for=\"note\">Ghi chú</label>\r\n          <textarea\r\n            v-model=\"customer.note\"\r\n            id=\"note\"\r\n            placeholder=\"Nhập ghi chú\"\r\n          ></textarea>\r\n        </div>\r\n      </div>\r\n      <div class=\"col-1\"></div>\r\n      <!-- Hiển thị danh sách sản phẩm trong đơn hàng -->\r\n      <div class=\"donhang col-lg-5 col-10\">\r\n        <h3>ĐƠN HÀNG CỦA BẠN</h3>\r\n        <div v-for=\"(item, index) in cart\" :key=\"index\" class=\"cart-item\">\r\n          <div class=\"cart-item-info\">\r\n            <img :src=\"item.image\" alt=\"product\" class=\"product-image\" />\r\n            <div>\r\n              <p class=\"product-name\">{{ item.name }}</p>\r\n              <p class=\"product-quantity\">Số lượng: {{ item.quantity }}</p>\r\n              <p class=\"product-price\">\r\n                {{ formatPrice(item.price * item.quantity) }}\r\n              </p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n  \r\n        <div class=\"total\">\r\n          <strong>Tổng cộng:</strong>\r\n          <span class=\"text-danger\">{{ formatPrice(totalPrice) }}</span>\r\n        </div>\r\n  \r\n        <button class=\"btn btn-success w-100 mt-3\" @click=\"showConfirmDialog\">\r\n          ĐẶT HÀNG\r\n        </button>\r\n      </div>\r\n    </div>\r\n    <v-dialog v-model=\"showDialog\" max-width=\"400\">\r\n      <v-card>\r\n        <v-card-title class=\"headline\">Xác nhận đặt hàng</v-card-title>\r\n        <v-card-text>Bạn có chắc chắn muốn đặt hàng không?</v-card-text>\r\n        <v-card-actions>\r\n          <v-btn color=\"red\" @click=\"showDialog = false\">Hủy</v-btn>\r\n          <v-btn color=\"green\" @click=\"placeOrder\">Xác nhận</v-btn>\r\n        </v-card-actions>\r\n      </v-card>\r\n    </v-dialog>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    name: \"CheckoutPage\",\r\n    data() {\r\n      return {\r\n        cart: [],\r\n        totalPrice: 0,\r\n        customer: {\r\n          name: \"\",\r\n          gender: \"male\",\r\n          address: \"\",\r\n          note: \"\",\r\n        },\r\n        showDialog: false,\r\n      };\r\n    },\r\n    created() {\r\n      const storedCart = localStorage.getItem(\"cart\");\r\n      if (storedCart) {\r\n        this.cart = JSON.parse(storedCart);\r\n      }\r\n  \r\n      this.totalPrice = this.cart.reduce(\r\n        (sum, item) => sum + item.price * item.quantity,\r\n        0\r\n      );\r\n    },\r\n    methods: {\r\n      formatPrice(value) {\r\n        return new Intl.NumberFormat(\"vi-VN\", {\r\n          style: \"currency\",\r\n          currency: \"VND\",\r\n        }).format(value);\r\n      },\r\n      showConfirmDialog() {\r\n        this.showDialog = true;\r\n      },\r\n      closeDialog() {\r\n        this.showDialog = false;\r\n      },\r\n      placeOrder() {\r\n        if (!this.customer.name || !this.customer.address) {\r\n          alert(\"Vui lòng nhập đầy đủ thông tin!\");\r\n          return;\r\n        }\r\n  \r\n        const orderData = {\r\n          customer: this.customer,\r\n          cart: this.cart,\r\n          totalPrice: this.totalPrice,\r\n          orderDate: new Date().toLocaleString(),\r\n        };\r\n  \r\n        console.log(\"Đơn hàng:\", orderData);\r\n        alert(\"Đơn hàng đã được đặt thành công!\");\r\n  \r\n        localStorage.removeItem(\"cart\");\r\n        localStorage.removeItem(\"totalPrice\");\r\n  \r\n        this.cart = [];\r\n        this.totalPrice = 0;\r\n        this.showDialog = false;\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .row {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: start;\r\n    flex-wrap: wrap;\r\n    gap: 20px;\r\n    padding: 20px;\r\n  }\r\n  \r\n  h3 {\r\n    text-align: center;\r\n    color: #333;\r\n    font-weight: bold;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  /* FORM THÔNG TIN */\r\n  .profile {\r\n    background: #f8f9fa;\r\n    padding: 20px;\r\n    border-radius: 10px;\r\n    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);\r\n  }\r\n  \r\n  .profile label {\r\n    font-weight: bold;\r\n    margin-bottom: 5px;\r\n    display: block;\r\n    color: #555;\r\n  }\r\n  \r\n  .profile input,\r\n  .profile select,\r\n  .profile textarea {\r\n    width: 100%;\r\n    padding: 10px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 5px;\r\n    font-size: 16px;\r\n    transition: 0.3s;\r\n  }\r\n  \r\n  .profile input:focus,\r\n  .profile select:focus,\r\n  .profile textarea:focus {\r\n    border-color: #28a745;\r\n    outline: none;\r\n    box-shadow: 0px 0px 8px rgba(40, 167, 69, 0.3);\r\n  }\r\n  \r\n  .inputnote textarea {\r\n    height: 80px;\r\n  }\r\n  \r\n  /* ĐƠN HÀNG */\r\n  .donhang {\r\n    background: white;\r\n    padding: 20px;\r\n    border-radius: 10px;\r\n    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);\r\n  }\r\n  \r\n  .cart-item {\r\n    display: flex;\r\n    align-items: center;\r\n    padding: 10px;\r\n    border-bottom: 1px solid #ddd;\r\n  }\r\n  \r\n  .cart-item:last-child {\r\n    border-bottom: none;\r\n  }\r\n  \r\n  .cart-item-info {\r\n    display: flex;\r\n    align-items: center;\r\n  }\r\n  \r\n  .product-image {\r\n    width: 80px;\r\n    height: 80px;\r\n    object-fit: cover;\r\n    border-radius: 8px;\r\n    margin-right: 15px;\r\n  }\r\n  \r\n  .product-name {\r\n    font-weight: bold;\r\n    font-size: 16px;\r\n    color: #333;\r\n  }\r\n  \r\n  .product-quantity,\r\n  .product-price {\r\n    color: #777;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  /* TỔNG TIỀN */\r\n  .total {\r\n    font-size: 18px;\r\n    font-weight: bold;\r\n    margin-top: 15px;\r\n    text-align: right;\r\n  }\r\n  \r\n  .text-danger {\r\n    color: red;\r\n  }\r\n  \r\n  /* BUTTON ĐẶT HÀNG */\r\n  .btn-success {\r\n    background: linear-gradient(to right, #2846a7, #526fcf);\r\n    color: white;\r\n    font-size: 18px;\r\n    padding: 12px;\r\n    border: none;\r\n    border-radius: 5px;\r\n    transition: 0.3s;\r\n  }\r\n  \r\n  .btn-success:hover {\r\n    background: linear-gradient(to right, #218838, #1e7e34);\r\n    transform: scale(1.05);\r\n  }\r\n  \r\n  /* RESPONSIVE */\r\n  @media (max-width: 768px) {\r\n    .profile,\r\n    .donhang {\r\n      width: 100%;\r\n    }\r\n  \r\n    .cart-item-info {\r\n      flex-direction: column;\r\n      text-align: center;\r\n    }\r\n  \r\n    .product-image {\r\n      margin-bottom: 10px;\r\n    }\r\n  \r\n    .total {\r\n      text-align: center;\r\n    }\r\n  }\r\n  </style>\r\n  "],"mappings":";;AAuFE,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,EAAE;MACRC,UAAU,EAAE,CAAC;MACbC,QAAQ,EAAE;QACRJ,IAAI,EAAE,EAAE;QACRK,MAAM,EAAE,MAAM;QACdC,OAAO,EAAE,EAAE;QACXC,IAAI,EAAE;MACR,CAAC;MACDC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,UAAS,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM,CAAC;IAC/C,IAAIF,UAAU,EAAE;MACd,IAAI,CAACR,IAAG,GAAIW,IAAI,CAACC,KAAK,CAACJ,UAAU,CAAC;IACpC;IAEA,IAAI,CAACP,UAAS,GAAI,IAAI,CAACD,IAAI,CAACa,MAAM,CAChC,CAACC,GAAG,EAAEC,IAAI,KAAKD,GAAE,GAAIC,IAAI,CAACC,KAAI,GAAID,IAAI,CAACE,QAAQ,EAC/C,CACF,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAACC,KAAK,EAAE;MACjB,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE;MACZ,CAAC,CAAC,CAACC,MAAM,CAACL,KAAK,CAAC;IAClB,CAAC;IACDM,iBAAiBA,CAAA,EAAG;MAClB,IAAI,CAACpB,UAAS,GAAI,IAAI;IACxB,CAAC;IACDqB,WAAWA,CAAA,EAAG;MACZ,IAAI,CAACrB,UAAS,GAAI,KAAK;IACzB,CAAC;IACDsB,UAAUA,CAAA,EAAG;MACX,IAAI,CAAC,IAAI,CAAC1B,QAAQ,CAACJ,IAAG,IAAK,CAAC,IAAI,CAACI,QAAQ,CAACE,OAAO,EAAE;QACjDyB,KAAK,CAAC,iCAAiC,CAAC;QACxC;MACF;MAEA,MAAMC,SAAQ,GAAI;QAChB5B,QAAQ,EAAE,IAAI,CAACA,QAAQ;QACvBF,IAAI,EAAE,IAAI,CAACA,IAAI;QACfC,UAAU,EAAE,IAAI,CAACA,UAAU;QAC3B8B,SAAS,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,cAAc,CAAC;MACvC,CAAC;MAEDC,OAAO,CAACC,GAAG,CAAC,WAAW,EAAEL,SAAS,CAAC;MACnCD,KAAK,CAAC,kCAAkC,CAAC;MAEzCpB,YAAY,CAAC2B,UAAU,CAAC,MAAM,CAAC;MAC/B3B,YAAY,CAAC2B,UAAU,CAAC,YAAY,CAAC;MAErC,IAAI,CAACpC,IAAG,GAAI,EAAE;MACd,IAAI,CAACC,UAAS,GAAI,CAAC;MACnB,IAAI,CAACK,UAAS,GAAI,KAAK;IACzB;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}