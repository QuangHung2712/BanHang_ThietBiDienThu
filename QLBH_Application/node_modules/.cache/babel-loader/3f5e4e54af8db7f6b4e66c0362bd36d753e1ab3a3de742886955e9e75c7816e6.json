{"ast":null,"code":"import { Swiper, SwiperSlide } from \"swiper/vue\";\nimport { Navigation, Autoplay } from \"swiper/modules\";\nexport default {\n  data() {\n    return {\n      modules: [Navigation, Autoplay],\n      data: [{\n        image: \"images/test/z3277142962677_4bdf325a013a1ace985c6d15a2cfe66a.jpg\",\n        productName: \"Tủ đông GoldCool\",\n        productPrice: \"10,000,000 VND\"\n      }, {\n        image: \"images/test/z3277143158749_978ce87bba64930b4e0bb27d3c615348.jpg\",\n        productName: \"Tủ mát GoldCool\",\n        productPrice: \"8,000,000 VND\"\n      }, {\n        image: \"images/test/z3277154203256_ef0789bbc28c686e512069187cbdbbcf.jpg\",\n        productName: \"Tủ trưng bày GoldCool\",\n        productPrice: \"15,000,000 VND\"\n      }]\n    };\n  },\n  name: \"LANDING\",\n  components: {\n    Swiper,\n    SwiperSlide\n  }\n};","map":{"version":3,"names":["Swiper","SwiperSlide","Navigation","Autoplay","data","modules","image","productName","productPrice","name","components"],"sources":["D:\\Du_An\\BanHang_ThietBiDienThu\\QLBH_Application\\src\\views\\SearchForProducts\\HomePage.vue"],"sourcesContent":["<style scoped>\r\n.saved-button {\r\n  color: red !important; /* Màu chữ trắng */\r\n}\r\n.product-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\r\n  gap: 20px;\r\n  margin-top: 20px;\r\n}\r\n.view-more {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n}\r\n.view-more button {\r\n  padding: 10px 20px;\r\n  background-color: #007bff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s ease;\r\n}\r\n.view-more button:hover {\r\n  background-color: #0056b3;\r\n}\r\n</style>\r\n<script>\r\nimport { Swiper, SwiperSlide } from \"swiper/vue\";\r\nimport { Navigation, Autoplay } from \"swiper/modules\";\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      modules: [Navigation, Autoplay],\r\n      data: [\r\n        {\r\n          image:\r\n            \"images/test/z3277142962677_4bdf325a013a1ace985c6d15a2cfe66a.jpg\",\r\n          productName: \"Tủ đông GoldCool\",\r\n          productPrice: \"10,000,000 VND\",\r\n        },\r\n        {\r\n          image:\r\n            \"images/test/z3277143158749_978ce87bba64930b4e0bb27d3c615348.jpg\",\r\n          productName: \"Tủ mát GoldCool\",\r\n          productPrice: \"8,000,000 VND\",\r\n        },\r\n        {\r\n          image:\r\n            \"images/test/z3277154203256_ef0789bbc28c686e512069187cbdbbcf.jpg\",\r\n          productName: \"Tủ trưng bày GoldCool\",\r\n          productPrice: \"15,000,000 VND\",\r\n        },\r\n      ],\r\n    };\r\n  },\r\n  name: \"LANDING\",\r\n  components: {\r\n    Swiper,\r\n    SwiperSlide,\r\n  },\r\n};\r\n</script>\r\n<template>\r\n  <swiper\r\n    :navigation=\"true\"\r\n    :autoplay=\"{ delay: 3000 }\"\r\n    :modules=\"modules\"\r\n    :loop=\"true\"\r\n    class=\"mySwiper\"\r\n  >\r\n    <swiper-slide v-for=\"(item, index) in data\" :key=\"index\">\r\n      <img :src=\"item.image\" alt=\"product\" class=\"img-fluid\" />\r\n    </swiper-slide>\r\n  </swiper>\r\n\r\n  <div class=\"container\">\r\n    <div class=\"contact\">\r\n      <h1>Chào mừng bạn đến với <b>An Chi</b></h1>\r\n      <p>\r\n        Chuyên cung cấp các thiết bị lạnh nhập khẩu như: Tủ mát, tủ đông, tủ\r\n        trưng bày bánh kem...\r\n      </p>\r\n    </div>\r\n\r\n    <div class=\"product\">\r\n      <h3>Giới thiệu về loại sản phẩm - Tủ đông</h3>\r\n      <div class=\"product-grid\">\r\n        <div class=\"product-card\" v-for=\"(item, index) in data\" :key=\"index\">\r\n            <router-link @click=\"GotoDetail(item.id)\" target=\"_blank\">\r\n                <div><img :src=\"item.pathImg\" alt=\"product\" /></div>\r\n                <div class=\"product-name\">{{ item.name }}</div>\r\n                <h4 style=\"color: red;\" class=\"text m-0\">{{ item.price.toLocaleString(\"vi-vn\") }} VNĐ</h4>\r\n            </router-link>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"product\">\r\n      <h3>Giới thiệu về loại sản phẩm - Tủ đông</h3>\r\n      <div class=\"product-grid\">\r\n        <div class=\"product-card\" v-for=\"(item, index) in data\" :key=\"index\">\r\n          <div><img :src=\"item.image\" alt=\"product\" /></div>\r\n          <div>{{ item.productName }}</div>\r\n          <div>{{ item.productPrice }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"product\">\r\n      <h3>Giới thiệu về loại sản phẩm - Tủ đông</h3>\r\n      <div class=\"product-grid\">\r\n        <div class=\"product-card\" v-for=\"(item, index) in data\" :key=\"index\">\r\n          <div><img :src=\"item.image\" alt=\"product\" /></div>\r\n          <div>{{ item.productName }}</div>\r\n          <div>{{ item.productPrice }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"product\">\r\n      <h3>Giới thiệu về loại sản phẩm - Tủ đông</h3>\r\n      <div class=\"product-grid\">\r\n        <div class=\"product-card\" v-for=\"(item, index) in data\" :key=\"index\">\r\n          <div><img :src=\"item.image\" alt=\"product\" /></div>\r\n          <div>{{ item.productName }}</div>\r\n          <div>{{ item.productPrice }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"view-more\">\r\n      <button @click=\"$router.push('/products')\">Xem thêm</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n"],"mappings":"AA4BA,SAASA,MAAM,EAAEC,WAAU,QAAS,YAAY;AAChD,SAASC,UAAU,EAAEC,QAAO,QAAS,gBAAgB;AAErD,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,CAACH,UAAU,EAAEC,QAAQ,CAAC;MAC/BC,IAAI,EAAE,CACJ;QACEE,KAAK,EACH,iEAAiE;QACnEC,WAAW,EAAE,kBAAkB;QAC/BC,YAAY,EAAE;MAChB,CAAC,EACD;QACEF,KAAK,EACH,iEAAiE;QACnEC,WAAW,EAAE,iBAAiB;QAC9BC,YAAY,EAAE;MAChB,CAAC,EACD;QACEF,KAAK,EACH,iEAAiE;QACnEC,WAAW,EAAE,uBAAuB;QACpCC,YAAY,EAAE;MAChB,CAAC;IAEL,CAAC;EACH,CAAC;EACDC,IAAI,EAAE,SAAS;EACfC,UAAU,EAAE;IACVV,MAAM;IACNC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}