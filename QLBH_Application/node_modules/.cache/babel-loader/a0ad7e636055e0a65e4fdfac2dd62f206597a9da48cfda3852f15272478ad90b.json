{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.filter.js\";\nimport \"core-js/modules/esnext.iterator.map.js\";\nimport \"core-js/modules/esnext.iterator.reduce.js\";\nexport default {\n  name: \"ShoppingPage\",\n  data() {\n    return {\n      products: [],\n      discountCode: \"\"\n    };\n  },\n  inject: [\"reloadquantityCart\"],\n  // Inject hàm từ cha vào\n  computed: {\n    totalPrice() {\n      return this.products.reduce((sum, product) => sum + product.price * product.quantity, 0);\n    },\n    cookieProduct() {\n      return JSON.parse(localStorage.getItem(\"cart\") ?? \"[]\");\n    },\n    StatusCart() {\n      return this.cookieProduct.length !== 0;\n    }\n  },\n  created() {\n    this.GetData();\n  },\n  methods: {\n    GetData() {\n      this.$apiClient.post(`/Product/GetAllProductById`, this.cookieProduct).then(response => {\n        this.products = response.data;\n      });\n    },\n    increaseQuantity(id) {\n      // Tìm index của sản phẩm cần cập nhật\n      let index = this.products.findIndex(item => item.id === id);\n      if (index !== -1) {\n        // Tăng quantity của sản phẩm\n        this.products[index].quantity++;\n\n        // Chỉ lưu id và quantity vào localStorage\n        let updateProduct = this.products.map(item => ({\n          id: item.id,\n          quantity: item.quantity\n        }));\n        localStorage.setItem(\"cart\", JSON.stringify(updateProduct));\n\n        // Cập nhật UI\n        this.reloadquantityCart();\n      }\n    },\n    decreaseQuantity(id) {\n      // Tìm index của sản phẩm cần cập nhật\n      let index = this.products.findIndex(item => item.id === id);\n      if (index !== -1) {\n        // Giảm quantity nhưng đảm bảo không dưới 0\n        this.products[index].quantity = Math.max(0, this.products[index].quantity - 1);\n\n        // Chỉ lưu id và quantity vào localStorage\n        let updateProduct = this.products.map(item => ({\n          id: item.id,\n          quantity: item.quantity\n        }));\n        localStorage.setItem(\"cart\", JSON.stringify(updateProduct));\n\n        // Gọi hàm cập nhật số lượng hiển thị giỏ hàng\n        this.reloadquantityCart();\n      }\n    },\n    removeProduct(id) {\n      try {\n        this.products = this.products.filter(item => item.id !== id);\n        localStorage.setItem(\"cart\", JSON.stringify(this.products ?? []));\n        this.reloadquantityCart();\n        this.$notify(\"Thao tác thành công\", \"Xoá sản phẩm khỏi giỏ hàng thành công\", \"success\");\n      } catch {\n        this.$notify(\"Đã xảy ra lỗi\", \"Xoá sản phẩm khỏi giỏ hàng đã xảy ra lỗi\", \"error\");\n      }\n    },\n    checkout() {\n      // Chuyển hướng sang trang thanh toán\n      this.$router.push(\"thanh-toan\");\n    }\n  }\n};","map":{"version":3,"names":["name","data","products","discountCode","inject","computed","totalPrice","reduce","sum","product","price","quantity","cookieProduct","JSON","parse","localStorage","getItem","StatusCart","length","created","GetData","methods","$apiClient","post","then","response","increaseQuantity","id","index","findIndex","item","updateProduct","map","setItem","stringify","reloadquantityCart","decreaseQuantity","Math","max","removeProduct","filter","$notify","checkout","$router","push"],"sources":["D:\\Du_An\\BanHang_ThietBiDienThu\\QLBH_Application\\src\\views\\SearchForProducts\\ProductCart.vue"],"sourcesContent":["<template style=\"min-height: auto\">\r\n    <div style=\"height: 50px\"></div>\r\n    <div class=\"shopping-page container\" v-if=\"StatusCart\">\r\n      <div class=\"row\">\r\n        <!-- Danh sách sản phẩm -->\r\n        <div\r\n          class=\"lstProduct col-lg-7 col-12\"\r\n          style=\"margin-right: 50px; margin-bottom: 50px\"\r\n        >\r\n          <div class=\"header row font-weight-bold border-bottom pb-2 mb-2\">\r\n            <div class=\"col-6 d-flex justify-content-center\">Sản phẩm</div>\r\n  \r\n            <div class=\"col-2\">Giá</div>\r\n            <div class=\"col-2\">Số lượng</div>\r\n            <div class=\"col-2\">Tạm tính</div>\r\n          </div>\r\n          <div class=\"product-list\">\r\n            <div\r\n              v-for=\"(product, index) in products\"\r\n              :key=\"index\"\r\n              class=\"product-item row align-items-center\"\r\n            >\r\n              <div class=\"col-1\">\r\n                <button @click=\"removeProduct(product.id)\" class=\"btn btn-danger\">\r\n                  x\r\n                </button>\r\n              </div>\r\n              <div class=\"col-2\">\r\n                <img :src=\"product.pathImg\" alt=\"product\" class=\"img-fluid\" />\r\n              </div>\r\n              <div class=\"col-3\">{{ product.name }}</div>\r\n              <div\r\n                class=\"col-2 text-danger\"\r\n                style=\"font-weight: bold; font-size: 1.2em\"\r\n              >\r\n                {{ this.$common.formatTablePrice(product.price) }}\r\n              </div>\r\n              <div class=\"col-2 d-flex align-items-center justify-content-center\">\r\n                <button @click=\"decreaseQuantity(product.id)\" class=\"quantity-btn\">\r\n                  -\r\n                </button>\r\n                <span class=\"mx-2 quantity-text\">{{ product.quantity }}</span>\r\n                <button @click=\"increaseQuantity(product.id)\" class=\"quantity-btn\">\r\n                  +\r\n                </button>\r\n              </div>\r\n              <div\r\n                class=\"col-2 text-danger\"\r\n                style=\"font-weight: bold; font-size: 1.2em\"\r\n              >\r\n                {{ this.$common.formatTablePrice(product.price * product.quantity) }}\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n  \r\n        <!-- Thanh toán -->\r\n        <div class=\"thanhtoan col-lg-4 col-10\">\r\n          <div class=\"thanhtoandetail p-4 border rounded\">\r\n            <h5 class=\"border-bottom pb-2\">TỔNG CỘNG GIỎ HÀNG</h5>\r\n            <div class=\"total d-flex justify-content-between\">\r\n              <span>Tạm tính:</span>\r\n              <span\r\n                class=\"text-danger\"\r\n                style=\"font-weight: bold; font-size: 1.1em\"\r\n                >{{ this.$common.formatTablePrice(totalPrice) }}</span\r\n              >\r\n            </div>\r\n            <div class=\"sum d-flex justify-content-between mt-2\">\r\n              <span>Tổng:</span>\r\n              <span\r\n                class=\"text-danger\"\r\n                style=\"font-weight: bold; font-size: 1.2em\"\r\n                >{{ this.$common.formatTablePrice(totalPrice) }}</span\r\n              >\r\n            </div>\r\n            <button class=\"btn w-100 mt-3 custom-btn\" @click=\"checkout\">\r\n              TIẾN HÀNH THANH TOÁN\r\n            </button>\r\n          </div>\r\n          <div class=\"saleCODE mt-3 p-3 border rounded\">\r\n            <label class=\"font-weight-bold\">Mã ưu đãi</label>\r\n            <input\r\n              v-model=\"discountCode\"\r\n              type=\"text\"\r\n              placeholder=\"Mã ưu đãi\"\r\n              class=\"form-control mt-1\"\r\n            />\r\n            <button class=\"btn w-100 mt-3 custom-btn\">Áp dụng</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <BCard style=\"margin-top: 100px\">\r\n        <BCardHeader class=\"p-0\">\r\n          <h3>Sản phẩm tương tự</h3>\r\n        </BCardHeader>\r\n        <BCardBody class=\"pl-0 pr-0\">\r\n          <v-slide-group v-model=\"model\" show-arrows class=\"pb-4\">\r\n            <v-slide-group-item\r\n              v-for=\"(itemProduct, indexProduct) in SimilarProducts\"\r\n              :key=\"indexProduct\"\r\n            >\r\n              <a\r\n                @click=\"GotoDetail(itemProduct.id)\"\r\n                target=\"_blank\"\r\n                class=\"product-card item m-2 my-3\"\r\n              >\r\n                <div>\r\n                  <img :src=\"itemProduct.pathImg\" alt=\"product\" />\r\n                </div>\r\n                <div class=\"product-name\">{{ itemProduct.name }}</div>\r\n                <h4 style=\"color: red\" class=\"text m-0\">\r\n                  {{ itemProduct.price.toLocaleString(\"vi-vn\") }} VNĐ\r\n                </h4>\r\n              </a>\r\n            </v-slide-group-item>\r\n          </v-slide-group>\r\n        </BCardBody>\r\n      </BCard>\r\n    </div>\r\n    <div v-else class=\"text-center\">\r\n      <h3>Chưa có sản phẩm nào trong giỏ hàng</h3>\r\n      <BButton type=\"button\" variant=\"primary\" style=\"width: 20%;\">Save Changes</BButton>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    name: \"ShoppingPage\",\r\n    data() {\r\n      return {\r\n        products: [\r\n        ],\r\n        discountCode: \"\",\r\n        \r\n      };\r\n    },\r\n    inject: [\"reloadquantityCart\"], // Inject hàm từ cha vào\r\n    computed: {\r\n      totalPrice() {\r\n        return this.products.reduce(\r\n          (sum, product) => sum + product.price * product.quantity,\r\n          0\r\n        );\r\n      },\r\n      cookieProduct(){\r\n        return  JSON.parse(localStorage.getItem(\"cart\") ?? \"[]\");\r\n      },\r\n      StatusCart(){\r\n        return this.cookieProduct.length !== 0;\r\n      }\r\n    },\r\n    created(){\r\n      this.GetData();\r\n    },\r\n    methods: {\r\n\r\n      GetData(){\r\n        this.$apiClient.post(`/Product/GetAllProductById`,this.cookieProduct)\r\n            .then((response) => {\r\n              this.products = response.data\r\n            })\r\n      },\r\n      increaseQuantity(id) {\r\n        // Tìm index của sản phẩm cần cập nhật\r\n          let index = this.products.findIndex(item => item.id === id);\r\n\r\n          if (index !== -1) {\r\n            // Tăng quantity của sản phẩm\r\n            this.products[index].quantity++;\r\n\r\n            // Chỉ lưu id và quantity vào localStorage\r\n            let updateProduct = this.products.map(item => ({ id: item.id, quantity: item.quantity }));\r\n            localStorage.setItem(\"cart\", JSON.stringify(updateProduct));\r\n\r\n            // Cập nhật UI\r\n            this.reloadquantityCart();\r\n        }\r\n      },\r\n      decreaseQuantity(id) {\r\n        // Tìm index của sản phẩm cần cập nhật\r\n        let index = this.products.findIndex(item => item.id === id);\r\n\r\n        if (index !== -1) {\r\n          // Giảm quantity nhưng đảm bảo không dưới 0\r\n          this.products[index].quantity = Math.max(0, this.products[index].quantity - 1);\r\n\r\n          // Chỉ lưu id và quantity vào localStorage\r\n          let updateProduct = this.products.map(item => ({ id: item.id, quantity: item.quantity }));\r\n          localStorage.setItem(\"cart\", JSON.stringify(updateProduct));\r\n\r\n          // Gọi hàm cập nhật số lượng hiển thị giỏ hàng\r\n          this.reloadquantityCart();\r\n        }\r\n      },\r\n      removeProduct(id) {\r\n        try{\r\n          this.products = this.products.filter(item => item.id !== id);\r\n          localStorage.setItem(\"cart\", JSON.stringify(this.products ?? []));\r\n          this.reloadquantityCart();\r\n          this.$notify(\r\n            \"Thao tác thành công\",\r\n            \"Xoá sản phẩm khỏi giỏ hàng thành công\",\r\n            \"success\"\r\n          );\r\n        }\r\n        catch{\r\n          this.$notify(\r\n            \"Đã xảy ra lỗi\",\r\n            \"Xoá sản phẩm khỏi giỏ hàng đã xảy ra lỗi\",\r\n            \"error\"\r\n          );\r\n        }\r\n      },\r\n      checkout() {\r\n  \r\n        // Chuyển hướng sang trang thanh toán\r\n        this.$router.push(\"thanh-toan\");\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .custom-btn {\r\n    background-color: #1eb8ff; /* Màu cam */\r\n    color: white;\r\n    border: none;\r\n  }\r\n  \r\n  .custom-btn:hover {\r\n    background-color: #b4e7ff; /* Màu cam đậm hơn khi hover */\r\n  }\r\n  \r\n  .product-item {\r\n    border-bottom: 1px solid #ddd;\r\n    padding: 10px 0;\r\n  }\r\n  button {\r\n    border: none;\r\n    background: #ddd;\r\n    border-radius: 5px;\r\n    width: 20px;\r\n    height: 30px;\r\n    padding: 5px 5px;\r\n    cursor: pointer;\r\n  }\r\n  .btn-danger {\r\n    background: transparent;\r\n    color: rgb(118, 118, 118);\r\n    border: 2px solid rgb(133, 133, 133);\r\n    border-radius: 50%;\r\n    width: 30px;\r\n    height: 30px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 0;\r\n  }\r\n  .thanhtoandetail {\r\n    background: #f8f9fa;\r\n    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\r\n  }\r\n  .saleCODE {\r\n    background: #ffffff;\r\n    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\r\n  }\r\n  </style>\r\n  "],"mappings":";;;;;AA+HE,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EACT;MACDC,YAAY,EAAE;IAEhB,CAAC;EACH,CAAC;EACDC,MAAM,EAAE,CAAC,oBAAoB,CAAC;EAAE;EAChCC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,OAAO,IAAI,CAACJ,QAAQ,CAACK,MAAM,CACzB,CAACC,GAAG,EAAEC,OAAO,KAAKD,GAAE,GAAIC,OAAO,CAACC,KAAI,GAAID,OAAO,CAACE,QAAQ,EACxD,CACF,CAAC;IACH,CAAC;IACDC,aAAaA,CAAA,EAAE;MACb,OAAQC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,MAAM,KAAK,IAAI,CAAC;IAC1D,CAAC;IACDC,UAAUA,CAAA,EAAE;MACV,OAAO,IAAI,CAACL,aAAa,CAACM,MAAK,KAAM,CAAC;IACxC;EACF,CAAC;EACDC,OAAOA,CAAA,EAAE;IACP,IAAI,CAACC,OAAO,CAAC,CAAC;EAChB,CAAC;EACDC,OAAO,EAAE;IAEPD,OAAOA,CAAA,EAAE;MACP,IAAI,CAACE,UAAU,CAACC,IAAI,CAAC,4BAA4B,EAAC,IAAI,CAACX,aAAa,EAC/DY,IAAI,CAAEC,QAAQ,IAAK;QAClB,IAAI,CAACvB,QAAO,GAAIuB,QAAQ,CAACxB,IAAG;MAC9B,CAAC;IACP,CAAC;IACDyB,gBAAgBA,CAACC,EAAE,EAAE;MACnB;MACE,IAAIC,KAAI,GAAI,IAAI,CAAC1B,QAAQ,CAAC2B,SAAS,CAACC,IAAG,IAAKA,IAAI,CAACH,EAAC,KAAMA,EAAE,CAAC;MAE3D,IAAIC,KAAI,KAAM,CAAC,CAAC,EAAE;QAChB;QACA,IAAI,CAAC1B,