{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.filter.js\";\nimport pageheader from \"@/components/page-header.vue\";\nexport default {\n  name: \"PRODUCT-LIST\",\n  components: {\n    pageheader\n  },\n  data() {\n    return {\n      searchProduct: null,\n      searchCustomerName: null,\n      searchSDTCustomer: null,\n      form: false,\n      headersTable: [{\n        title: 'Mã đơn hàng',\n        value: 'id',\n        sortable: true\n      }, {\n        title: 'Tên khách hàng',\n        value: 'customerName',\n        sortable: true\n      }, {\n        title: 'Tên sản phẩm',\n        value: 'productName',\n        sortable: true\n      }, {\n        title: 'SĐT',\n        value: 'sdtCustomer',\n        sortable: true\n      }, {\n        title: 'Địa chỉ',\n        value: 'address',\n        sortable: true\n      }],\n      headersTableProduct: [{\n        title: 'Tên sản phẩm',\n        value: 'productName',\n        sortable: true\n      }, {\n        title: 'Số lượng',\n        value: 'productNumber',\n        sortable: true\n      }, {\n        title: 'Đơn giá',\n        value: 'price',\n        sortable: true\n      }, {\n        title: 'Tổng tiền',\n        value: 'sumPrice',\n        sortable: true\n      }],\n      orderData: [],\n      product: [],\n      order: {},\n      viewdialog: false\n    };\n  },\n  computed: {\n    filteredData() {\n      return this.orderData.filter(item => {\n        // Lọc theo loại sản phẩm\n        const matchesProduct = this.searchProduct ? item.productId === this.searchProduct : true;\n\n        // Lọc theo tên khách \n        const matchesSearchCustomerName = this.searchCustomerName ? item.customerName?.toLowerCase().includes(this.searchCustomerName.toLowerCase()) : true;\n        const matchesSearchSDTCustomer = this.searchSDTCustomer ? item.sdtCustomer?.includes(this.searchSDTCustomer) : true;\n        return matchesProduct && matchesSearchCustomerName && matchesSearchSDTCustomer;\n      });\n    }\n  },\n  created() {\n    this.GetData();\n    this.GetProduct();\n  },\n  methods: {\n    GetData() {\n      this.$apiClient.get(`/Order/GetAll`).then(response => {\n        this.orderData = response.data;\n      }).catch(error => {\n        this.$notify(error.response.data.Message, error.response.data.Errors.join('. '), \"error\");\n      });\n    },\n    GetProduct() {\n      this.$apiClient.get(`/Product/GetAll`).then(response => {\n        this.product = response.data;\n      });\n    },\n    Detail(Id) {\n      this.$apiClient.get(`/Order/GetDetail/${Id}`).then(response => {\n        this.order = response.data;\n        this.viewdialog = true;\n        console.log(this.order);\n      });\n    }\n  }\n};","map":{"version":3,"names":["pageheader","name","components","data","searchProduct","searchCustomerName","searchSDTCustomer","form","headersTable","title","value","sortable","headersTableProduct","orderData","product","order","viewdialog","computed","filteredData","filter","item","matchesProduct","productId","matchesSearchCustomerName","customerName","toLowerCase","includes","matchesSearchSDTCustomer","sdtCustomer","created","GetData","GetProduct","methods","$apiClient","get","then","response","catch","error","$notify","Message","Errors","join","Detail","Id","console","log"],"sources":["D:\\Du_An\\BanHang_ThietBiDienThu\\QLBH_Application\\src\\views\\Manage\\Page\\Order.vue"],"sourcesContent":["<script>\r\n    import pageheader from \"@/components/page-header.vue\"\r\n    export default {\r\n        name: \"PRODUCT-LIST\",\r\n        components: {\r\n            pageheader\r\n        },\r\n        data(){\r\n            return{\r\n                searchProduct: null,\r\n                searchCustomerName: null,\r\n                searchSDTCustomer: null,\r\n                form: false,\r\n                headersTable:[\r\n                        {title: 'Mã đơn hàng', value: 'id',sortable: true},\r\n                        {title: 'Tên khách hàng',value:'customerName',sortable: true},\r\n                        {title: 'Tên sản phẩm',value:'productName',sortable: true},\r\n                        {title: 'SĐT',value:'sdtCustomer',sortable: true},\r\n                        {title: 'Địa chỉ',value:'address',sortable: true},\r\n                    ],\r\n                headersTableProduct:[\r\n                    {title: 'Tên sản phẩm', value: 'productName',sortable: true},\r\n                    {title: 'Số lượng',value:'productNumber',sortable: true},\r\n                    {title: 'Đơn giá',value:'price',sortable: true},\r\n                    {title: 'Tổng tiền',value:'sumPrice',sortable: true},\r\n                ],\r\n                orderData: [\r\n\r\n                ],\r\n                product:[\r\n\r\n                ],\r\n                order:{\r\n\r\n                },\r\n                viewdialog: false\r\n            }\r\n        },\r\n        computed:{\r\n            filteredData() {\r\n                return this.orderData.filter((item) => {\r\n                    // Lọc theo loại sản phẩm\r\n                    const matchesProduct = this.searchProduct\r\n                    ? item.productId === this.searchProduct\r\n                    : true;\r\n\r\n                    // Lọc theo tên khách \r\n                    const matchesSearchCustomerName = this.searchCustomerName\r\n                    ? item.customerName?.toLowerCase().includes(this.searchCustomerName.toLowerCase())\r\n                    : true;\r\n                    const matchesSearchSDTCustomer = this.searchSDTCustomer\r\n                    ? item.sdtCustomer?.includes(this.searchSDTCustomer)\r\n                    : true;\r\n\r\n\r\n                    return matchesProduct &&  matchesSearchCustomerName && matchesSearchSDTCustomer;\r\n                });\r\n            },\r\n        },\r\n        created(){\r\n            this.GetData();\r\n            this.GetProduct();\r\n        },\r\n        methods:{\r\n            GetData(){\r\n                this.$apiClient.get(`/Order/GetAll`)\r\n                        .then(response=>{\r\n                            this.orderData = response.data;\r\n                        })\r\n                        .catch(error=>{\r\n                            this.$notify(error.response.data.Message,error.response.data.Errors.join('. '),\"error\");\r\n                        })\r\n            },\r\n            GetProduct(){\r\n                this.$apiClient.get(`/Product/GetAll`)\r\n                        .then(response=>{\r\n                            this.product = response.data;\r\n                        })\r\n            },\r\n            Detail(Id){\r\n                this.$apiClient.get(`/Order/GetDetail/${Id}`)\r\n                        .then(response=>{\r\n                            this.order = response.data;\r\n                            this.viewdialog = true\r\n                            console.log(this.order)\r\n                        })\r\n            },\r\n        }\r\n}\r\n</script>\r\n\r\n\r\n\r\n<template>\r\n        <pageheader title=\"\" pageTitle=\"Chờ tư vấn\" />\r\n        <BRow>\r\n            <BCol class=\"col-sm-12\">\r\n                <BCard>\r\n                    <BCardBody class=\"p-0\">\r\n                        <BRow>\r\n                            <BCol class=\"col-sm-4 col-6\">\r\n                                <v-autocomplete\r\n                                    clearable\r\n                                    label=\"Sản phẩm\"\r\n                                    :items=\"product\"\r\n                                    item-title=\"name\"\r\n                                    item-value=\"id\"\r\n                                    v-model=\"searchProduct\"\r\n                                    variant=\"outlined\"\r\n                                    hide-details>\r\n                                </v-autocomplete>\r\n                            </BCol>\r\n                            <Bcol class=\"col-sm-4 col-6\"><v-text-field label=\"Tên khách hàng\" variant=\"outlined\" v-model=\"searchCustomerName\" clearable hide-details></v-text-field></Bcol>\r\n                            <Bcol class=\"col-sm-4 col-6\"><v-text-field label=\"SĐT khách hàng\" variant=\"outlined\" v-model=\"searchSDTCustomer\" clearable hide-details></v-text-field></Bcol>\r\n\r\n                        </BRow>\r\n                    </BCardBody>\r\n                </BCard>\r\n                <BCard no-body class=\"table-card p-sm-2\">\r\n                    <BCardBody>\r\n                        <v-data-table \r\n                            :headers = \"headersTable\"\r\n                            :items=\"filteredData\"\r\n                            class=\"border-sm rounded-lg\">\r\n                            <template v-slot:[`item.id`]=\"{ item }\">\r\n                                <button @click=\"Detail(item.id)\" class=\"text-primary\">{{ item.id }}</button>\r\n                            </template>\r\n                            <template v-slot:[`item.productName`]=\"{ item }\">\r\n                                <span v-for=\"(itemProduct,index) in item.products\" :key=\"index\">{{ itemProduct.productName }} (x{{ itemProduct.productNumber }})</span>\r\n                            </template>\r\n                        </v-data-table>\r\n                    </BCardBody>\r\n                </BCard>\r\n            </BCol>\r\n        </BRow>\r\n        <BModal v-model=\"viewdialog\" hide-footer \r\n            :title=\"`Chi tiết đơn hàng: ${order.id} - ${order.orderDate}`\"\r\n            modal-class=\"fadeInRight\"\r\n            class=\"v-modal-custom\" centered size=\"xl\" >\r\n        <div class=\"card-body\">\r\n            <v-form v-model=\"form\" ref=\"form\">\r\n                <BRow>\r\n                    <BCard no-body>\r\n                        <BCardHeader class=\"p-3 \"><h4 class=\"m-0\">Khách hàng</h4></BCardHeader>\r\n                        <BCardBody  class=\"p-3\">\r\n                            <h5>{{ order.customerName }} - {{ order.gender }}</h5>\r\n                            <p class=\"m-0\">SĐT: {{ order.sdtCustomer }} </p>\r\n                            <p>Địa chỉ: {{ order.address }}</p>\r\n                        </BCardBody>\r\n                    </BCard>\r\n                    <v-data-table \r\n                        :headers = \"headersTableProduct\"\r\n                        :items=\"order.products\"\r\n                        class=\"border-sm rounded-lg\"\r\n                        header-class=\"custom-header\"\r\n                        >\r\n                        <template v-slot:[`item.productName`]=\"{ item }\">\r\n                            <div class=\"d-flex align-center mt-1\">\r\n                                <v-avatar :image=\"item.productIMG\" size=\"60\" class=\"mr-1\"></v-avatar>\r\n                                <div>\r\n                                    <h5 class=\"m-0\">{{ item.productName }}</h5>\r\n                                    <p class=\"m-0\">Mã sản phẩm: {{ item.id }}</p>\r\n                                </div>\r\n                            </div>\r\n                        </template>\r\n                        <template v-slot:[`item.price`]=\"{ item }\">\r\n                           {{ this.$common.formatTablePrice(item.price) }}\r\n                        </template>\r\n                        <template v-slot:[`item.sumPrice`]=\"{ item }\">\r\n                           {{ this.$common.formatTablePrice(item.price * item.productNumber) }}\r\n                        </template>\r\n                    </v-data-table>\r\n                    \r\n                </BRow>\r\n            </v-form>\r\n        </div>\r\n        <div class=\"modal-footer v-modal-footer\">\r\n            <div class=\"d-flex\">\r\n                <h3>1.000.000</h3>\r\n                <BButton type=\"button\" variant=\"light\" @click=\"viewdialog = false\">Close\r\n                </BButton>\r\n            </div>\r\n            \r\n        </div>\r\n    </BModal>\r\n</template>\r\n<style scoped>\r\n    .custom-header {\r\n        background-color: #f5f5f5 !important; /* Đổi màu header */\r\n        color: white !important; /* Đổi màu chữ */\r\n        font-weight: bold !important; /* In đậm */\r\n        text-transform: uppercase; /* Viết hoa tiêu đề */\r\n    }\r\n</style>\r\n\r\n"],"mappings":";;AACI,OAAOA,UAAS,MAAO,8BAA6B;AACpD,eAAe;EACXC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACRF;EACJ,CAAC;EACDG,IAAIA,CAAA,EAAE;IACF,OAAM;MACFC,aAAa,EAAE,IAAI;MACnBC,kBAAkB,EAAE,IAAI;MACxBC,iBAAiB,EAAE,IAAI;MACvBC,IAAI,EAAE,KAAK;MACXC,YAAY,EAAC,CACL;QAACC,KAAK,EAAE,aAAa;QAAEC,KAAK,EAAE,IAAI;QAACC,QAAQ,EAAE;MAAI,CAAC,EAClD;QAACF,KAAK,EAAE,gBAAgB;QAACC,KAAK,EAAC,cAAc;QAACC,QAAQ,EAAE;MAAI,CAAC,EAC7D;QAACF,KAAK,EAAE,cAAc;QAACC,KAAK,EAAC,aAAa;QAACC,QAAQ,EAAE;MAAI,CAAC,EAC1D;QAACF,KAAK,EAAE,KAAK;QAACC,KAAK,EAAC,aAAa;QAACC,QAAQ,EAAE;MAAI,CAAC,EACjD;QAACF,KAAK,EAAE,SAAS;QAACC,KAAK,EAAC,SAAS;QAACC,QAAQ,EAAE;MAAI,CAAC,CACpD;MACLC,mBAAmB,EAAC,CAChB;QAACH,KAAK,EAAE,cAAc;QAAEC,KAAK,EAAE,aAAa;QAACC,QAAQ,EAAE;MAAI,CAAC,EAC5D;QAACF,KAAK,EAAE,UAAU;QAACC,KAAK,EAAC,eAAe;QAACC,QAAQ,EAAE;MAAI,CAAC,EACxD;QAACF,KAAK,EAAE,SAAS;QAACC,KAAK,EAAC,OAAO;QAACC,QAAQ,EAAE;MAAI,CAAC,EAC/C;QAACF,KAAK,EAAE,WAAW;QAACC,KAAK,EAAC,UAAU;QAACC,QAAQ,EAAE;MAAI,CAAC,CACvD;MACDE,SAAS,EAAE,EAEV;MACDC,OAAO,EAAC,EAEP;MACDC,KAAK,EAAC,CAEN,CAAC;MACDC,UAAU,EAAE;IAChB;EACJ,CAAC;EACDC,QAAQ,EAAC;IACLC,YAAYA,CAAA,EAAG;MACX,OAAO,IAAI,CAACL,SAAS,CAACM,MAAM,CAAEC,IAAI,IAAK;QACnC;QACA,MAAMC,cAAa,GAAI,IAAI,CAACjB,aAAY,GACtCgB,IAAI,CAACE,SAAQ,KAAM,IAAI,CAAClB,aAAY,GACpC,IAAI;;QAEN;QACA,MAAMmB,yBAAwB,GAAI,IAAI,CAAClB,kBAAiB,GACtDe,IAAI,CAACI,YAAY,EAAEC,WAAW,CAAC,CAAC,CAACC,QAAQ,CAAC,IAAI,CAACrB,kBAAkB,CAACoB,WAAW,CAAC,CAAC,IAC/E,IAAI;QACN,MAAME,wBAAuB,GAAI,IAAI,CAACrB,iBAAgB,GACpDc,IAAI,CAACQ,WAAW,EAAEF,QAAQ,CAAC,IAAI,CAACpB,iBAAiB,IACjD,IAAI;QAGN,OAAOe,cAAa,IAAME,yBAAwB,IAAKI,