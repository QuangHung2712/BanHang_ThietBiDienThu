{"ast":null,"code":"import { Swiper, SwiperSlide } from \"swiper/vue\";\nimport { Navigation, Autoplay } from \"swiper/modules\";\nexport default {\n  data() {\n    return {\n      modules: [Navigation, Autoplay],\n      data: [],\n      model: null\n    };\n  },\n  name: \"LANDING\",\n  components: {\n    Swiper,\n    SwiperSlide\n  },\n  created() {\n    this.GetProduct();\n  },\n  methods: {\n    GetProduct() {\n      this.$apiClient.get(`/Product/GetAllProductByType`).then(response => {\n        this.data = response.data;\n        console.log(this.data);\n      });\n    },\n    GotoDetail(id) {\n      const route = this.$router.resolve({\n        name: 'detail',\n        params: {\n          productId: id\n        }\n      });\n      window.open(route.href, '_blank');\n    }\n  }\n};","map":{"version":3,"names":["Swiper","SwiperSlide","Navigation","Autoplay","data","modules","model","name","components","created","GetProduct","methods","$apiClient","get","then","response","console","log","GotoDetail","id","route","$router","resolve","params","productId","window","open","href"],"sources":["D:\\Du_An\\BanHang_ThietBiDienThu\\QLBH_Application\\src\\views\\SearchForProducts\\HomePage.vue"],"sourcesContent":["<style scoped>\r\n.saved-button {\r\n    color: red !important; /* Màu chữ trắng */\r\n}\r\n/* .product-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\r\n  gap: 20px;\r\n  margin-top: 20px;\r\n} */\r\n.view-more {\r\n    margin-top: 20px;\r\n    text-align: center;\r\n}\r\n.view-more button {\r\n    padding: 10px 20px;\r\n    background-color: #007bff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 5px;\r\n    cursor: pointer;\r\n    transition: background-color 0.3s ease;\r\n}\r\n.view-more button:hover {\r\n  background-color: #0056b3;\r\n}\r\n.item{\r\n    width: 25% !important;\r\n}\r\n@media (max-width: 768px) {\r\n    .item{\r\n        width: 50% !important;\r\n    }\r\n}\r\n</style>\r\n<script>\r\nimport { Swiper, SwiperSlide } from \"swiper/vue\";\r\nimport { Navigation, Autoplay } from \"swiper/modules\";\r\n\r\nexport default {\r\n    data() {\r\n    return {\r\n        modules: [Navigation, Autoplay],\r\n        data: [\r\n\r\n        ],\r\n        model: null\r\n    };\r\n    },\r\n    name: \"LANDING\",\r\n    components: {\r\n        Swiper,\r\n        SwiperSlide,\r\n    },\r\n    created(){\r\n        this.GetProduct();\r\n    },\r\n    methods:{\r\n        GetProduct(){\r\n            this.$apiClient.get(`/Product/GetAllProductByType`)\r\n                    .then(response=>{\r\n                        this.data = response.data;\r\n                        console.log(this.data);\r\n                    })\r\n        },\r\n        GotoDetail(id){\r\n            const route = this.$router.resolve({ name: 'detail', params: { productId: id } });\r\n            window.open(route.href, '_blank');\r\n\r\n        }\r\n    }\r\n};\r\n</script>\r\n<template>\r\n  <swiper :navigation=\"true\" :autoplay=\"true\" :modules=\"modules\" :loop=\"true\" class=\"mySwiper\">\r\n        <swiper-slide> <img src=\"images/test/z3277142962677_4bdf325a013a1ace985c6d15a2cfe66a.jpg\" alt=\"\"\r\n                class=\"img-fluid\"></swiper-slide>\r\n        <swiper-slide><img src=\"images/test/z3277143158749_978ce87bba64930b4e0bb27d3c615348.jpg\" alt=\"\"\r\n                class=\"img-fluid\"></swiper-slide>\r\n        <swiper-slide> <img src=\"images/test/z3277154203256_ef0789bbc28c686e512069187cbdbbcf.jpg\" alt=\"\"\r\n                class=\"img-fluid\"></swiper-slide>\r\n    </swiper>\r\n\r\n    <v-container>\r\n        <div class=\"contact\">\r\n        <h1>Chào mừng bạn đến với <b>An Chi</b></h1>\r\n        <p>\r\n            Chuyên cung cấp các thiết bị lạnh nhập khẩu như: Tủ mát, tủ đông, tủ\r\n            trưng bày bánh kem...\r\n        </p>\r\n        </div>\r\n        <BCard  v-for=\"(item, index) in data\" :key=\"index\">\r\n            <BCardHeader class=\"p-0\">\r\n                <h3>Giới thiệu về loại sản phẩm - {{ item.productName }}</h3>\r\n            </BCardHeader>\r\n            <BCardBody class=\"pl-0 pr-0\">\r\n                <v-slide-group v-model=\"model\" show-arrows class=\"p-2\">\r\n                    <v-slide-group-item v-for=\"(itemProduct, indexProduct) in item.products\" :key=\"indexProduct\" class=\"\">\r\n                        <!-- <div class=\"product-card p-2 item\"> -->\r\n                            <router-link @click=\"GotoDetail(itemProduct.id)\" target=\"_blank\" class=\"product-card item m-2\">\r\n                                <div><img :src=\"itemProduct.pathImg\" alt=\"product\" /></div>\r\n                                <div class=\"product-name\">{{ itemProduct.name }}</div>\r\n                                <h4 style=\"color: red;\" class=\"text m-0\">{{ itemProduct.price.toLocaleString(\"vi-vn\") }} VNĐ</h4>\r\n                            </router-link>\r\n                        <!-- </div> -->\r\n                    </v-slide-group-item>\r\n                </v-slide-group>\r\n            </BCardBody>\r\n        </BCard>\r\n        <!-- <div class=\"product\" v-for=\"(item, index) in data\" :key=\"index\">\r\n            <h3>Giới thiệu về loại sản phẩm - {{ item.productName }}</h3>\r\n            <BRow>\r\n                <div class=\"col-xl-3  p-2\" v-for=\"(itemProduct, indexProduct) in item.products\" :key=\"indexProduct\">\r\n                    <div class=\"product-card\">\r\n                        <router-link @click=\"GotoDetail(itemProduct.id)\" target=\"_blank\">\r\n                            <div><img :src=\"itemProduct.pathImg\" alt=\"product\" /></div>\r\n                            <div class=\"product-name\">{{ itemProduct.name }}</div>\r\n                            <h4 style=\"color: red;\" class=\"text m-0\">{{ itemProduct.price.toLocaleString(\"vi-vn\") }} VNĐ</h4>\r\n                        </router-link>\r\n                    </div>\r\n                </div>\r\n            </BRow>\r\n            <v-slide-group v-model=\"model\" show-arrows>\r\n                <v-slide-group-item v-for=\"(itemProduct, indexProduct) in item.products\" :key=\"indexProduct\" class=\"p-2\">\r\n                    <div class=\"product-card item\">\r\n                        <router-link @click=\"GotoDetail(itemProduct.id)\" target=\"_blank\">\r\n                            <div><img :src=\"itemProduct.pathImg\" alt=\"product\" /></div>\r\n                            <div class=\"product-name\">{{ itemProduct.name }}</div>\r\n                            <h4 style=\"color: red;\" class=\"text m-0\">{{ itemProduct.price.toLocaleString(\"vi-vn\") }} VNĐ</h4>\r\n                        </router-link>\r\n                    </div>\r\n                </v-slide-group-item>\r\n            </v-slide-group>\r\n        </div> -->\r\n        <div class=\"view-more\">\r\n        <button @click=\"$router.push('/products')\">Xem thêm</button>\r\n        </div>\r\n    </v-container>\r\n</template>\r\n"],"mappings":"AAoCA,SAASA,MAAM,EAAEC,WAAU,QAAS,YAAY;AAChD,SAASC,UAAU,EAAEC,QAAO,QAAS,gBAAgB;AAErD,eAAe;EACXC,IAAIA,CAAA,EAAG;IACP,OAAO;MACHC,OAAO,EAAE,CAACH,UAAU,EAAEC,QAAQ,CAAC;MAC/BC,IAAI,EAAE,EAEL;MACDE,KAAK,EAAE;IACX,CAAC;EACD,CAAC;EACDC,IAAI,EAAE,SAAS;EACfC,UAAU,EAAE;IACRR,MAAM;IACNC;EACJ,CAAC;EACDQ,OAAOA,CAAA,EAAE;IACL,IAAI,CAACC,UAAU,CAAC,CAAC;EACrB,CAAC;EACDC,OAAO,EAAC;IACJD,UAAUA,CAAA,EAAE;MACR,IAAI,CAACE,UAAU,CAACC,GAAG,CAAC,8BAA8B,EACzCC,IAAI,CAACC,QAAQ,IAAE;QACZ,IAAI,CAACX,IAAG,GAAIW,QAAQ,CAACX,IAAI;QACzBY,OAAO,CAACC,GAAG,CAAC,IAAI,CAACb,IAAI,CAAC;MAC1B,CAAC;IACb,CAAC;IACDc,UAAUA,CAACC,EAAE,EAAC;MACV,MAAMC,KAAI,GAAI,IAAI,CAACC,OAAO,CAACC,OAAO,CAAC;QAAEf,IAAI,EAAE,QAAQ;QAAEgB,MAAM,EAAE;UAAEC,SAAS,EAAEL;QAAG;MAAE,CAAC,CAAC;MACjFM,MAAM,CAACC,IAAI,CAACN,KAAK,CAACO,IAAI,EAAE,QAAQ,CAAC;IAErC;EACJ;AACJ,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}