{"ast":null,"code":"import pageheader from \"@/components/page-header.vue\";\nexport default {\n  name: \"PRODUCT-DETAIL\",\n  components: {\n    pageheader\n  },\n  data() {\n    return {\n      currentSlide: 0,\n      product: {\n        // sanpham\n        name: null,\n        pathImg: [],\n        price: 0,\n        infoProduct: []\n      },\n      SimilarProducts: [],\n      // sanpham tuong tu\n      Advise: {\n        //\n        customerName: null,\n        sDTCustomer: null,\n        address: null,\n        email: null,\n        note: null,\n        productId: null,\n        gender: 1\n      },\n      index: 0,\n      visible: false,\n      model: null,\n      ViewAdvise: false,\n      form: false\n    };\n  },\n  created() {\n    const productId = this.$route.params.productId;\n    this.GetDetail(productId);\n  },\n  methods: {\n    GetDetail(Id) {\n      this.$apiClient.get(`/Product/GetDetail/${Id}`).then(response => {\n        this.product = response.data;\n        this.$apiClient.get(`/Product/GetProductByType?productType=${this.product.productTypeId}&id=${Id}`).then(response => {\n          this.SimilarProducts = response.data;\n        });\n      });\n    },\n    showImg(index) {\n      this.index = index;\n      this.visible = true;\n    },\n    handleHide() {\n      this.visible = false;\n    },\n    GotoDetail(id) {\n      this.$router.replace({\n        name: this.$route.name,\n        params: {\n          productId: id\n        }\n      });\n      this.GetDetail(id);\n      window.scrollTo({\n        top: 0,\n        behavior: \"smooth\"\n      }); // Cuộn lên đầu trang\n    },\n    btnAdvise() {\n      this.ViewAdvise = !this.ViewAdvise;\n      this.Advise = {\n        customerName: null,\n        sDTCustomer: null,\n        address: null,\n        gender: 1,\n        productId: this.product.id\n      };\n    },\n    SaveAdvise() {\n      console.log(this.Advise);\n      this.$apiClient.post(`/Order/Create`, this.Advise).then(() => {\n        this.$notify(\"Thao tác thành công\", \"Bạn vui lòng để ý tin nhắn  chúng tôi sẽ liên hệ với bạn\", \"success\");\n        this.ViewAdvise = false;\n      });\n    }\n  }\n};","map":{"version":3,"names":["pageheader","name","components","data","currentSlide","product","pathImg","price","infoProduct","SimilarProducts","Advise","customerName","sDTCustomer","address","email","note","productId","gender","index","visible","model","ViewAdvise","form","created","$route","params","GetDetail","methods","Id","$apiClient","get","then","response","productTypeId","showImg","handleHide","GotoDetail","id","$router","replace","window","scrollTo","top","behavior","btnAdvise","SaveAdvise","console","log","post","$notify"],"sources":["D:\\Du_An\\BanHang_ThietBiDienThu\\QLBH_Application\\src\\views\\SearchForProducts\\ProductDetail.vue"],"sourcesContent":["<script>\r\nimport pageheader from \"@/components/page-header.vue\";\r\nexport default {\r\n  name: \"PRODUCT-DETAIL\",\r\n  components: {\r\n    pageheader,\r\n  },\r\n  data() {\r\n    return {\r\n      currentSlide: 0,\r\n      product: {\r\n        // sanpham\r\n        name: null,\r\n        pathImg: [],\r\n        price: 0,\r\n        infoProduct: [],\r\n      },\r\n      SimilarProducts: [], // sanpham tuong tu\r\n      Advise: {\r\n        //\r\n        customerName: null,\r\n        sDTCustomer: null,\r\n        address: null,\r\n        email: null,\r\n        note: null, \r\n        productId: null,\r\n        gender: 1,\r\n      },\r\n      index: 0,\r\n      visible: false,\r\n      model: null,\r\n      ViewAdvise: false,\r\n      form: false,\r\n    };\r\n  },\r\n  created() {\r\n    const productId = this.$route.params.productId;\r\n    this.GetDetail(productId);\r\n  },\r\n  methods: {\r\n    GetDetail(Id) {\r\n      this.$apiClient.get(`/Product/GetDetail/${Id}`).then((response) => {\r\n        this.product = response.data;\r\n        this.$apiClient\r\n          .get(\r\n            `/Product/GetProductByType?productType=${this.product.productTypeId}&id=${Id}`\r\n          )\r\n          .then((response) => {\r\n            this.SimilarProducts = response.data;\r\n          });\r\n      });\r\n    },\r\n    showImg(index) {\r\n      this.index = index;\r\n      this.visible = true;\r\n    },\r\n    handleHide() {\r\n      this.visible = false;\r\n    },\r\n    GotoDetail(id) {\r\n      this.$router.replace({\r\n        name: this.$route.name,\r\n        params: { productId: id },\r\n      });\r\n      this.GetDetail(id);\r\n      window.scrollTo({ top: 0, behavior: \"smooth\" }); // Cuộn lên đầu trang\r\n    },\r\n    btnAdvise() {\r\n      this.ViewAdvise = !this.ViewAdvise;\r\n      this.Advise = {\r\n        customerName: null,\r\n        sDTCustomer: null,\r\n        address: null,\r\n        gender: 1,\r\n        productId: this.product.id,\r\n      };\r\n    },\r\n    SaveAdvise() {\r\n      console.log(this.Advise);\r\n      this.$apiClient.post(`/Order/Create`, this.Advise).then(() => {\r\n        this.$notify(\r\n          \"Thao tác thành công\",\r\n          \"Bạn vui lòng để ý tin nhắn  chúng tôi sẽ liên hệ với bạn\",\r\n          \"success\"\r\n        );\r\n        this.ViewAdvise = false;\r\n      });\r\n    },\r\n  },\r\n};\r\n</script>\r\n<template>\r\n  <pageheader title=\"Chi tiết sản phẩm\" pageTitle=\"Sản phẩm\" />\r\n  <div class=\"container\">\r\n    <BRow class=\"mb-10\">\r\n      <BCol class=\"col-xl-7 col-12\">\r\n        <v-row justify=\"center\" class=\"m-0\">\r\n          <!-- Carousel chính -->\r\n          <v-carousel\r\n            v-model=\"currentSlide\"\r\n            hide-delimiters\r\n            show-arrows=\"hover\"\r\n            height=\"480\"\r\n          >\r\n            <v-carousel-item\r\n              v-for=\"(item, index) in product.pathImg\"\r\n              :key=\"index\"\r\n            >\r\n              <v-img :src=\"item\" @click=\"showImg(index)\" />\r\n            </v-carousel-item>\r\n          </v-carousel>\r\n\r\n          <!-- Thumbnails -->\r\n          <v-row justify=\"center\" class=\"m-0\">\r\n            <div\r\n              v-for=\"(item, index) in product.pathImg\"\r\n              :key=\"index\"\r\n              @click=\"currentSlide = index\"\r\n              class=\"thumbnail-container\"\r\n            >\r\n              <v-img\r\n                :src=\"item\"\r\n                :alt=\"'Ảnh phòng ' + index\"\r\n                class=\"thumbnail\"\r\n                :class=\"{ active: currentSlide === index }\"\r\n              />\r\n            </div>\r\n          </v-row>\r\n        </v-row>\r\n      </BCol>\r\n      <BCol class=\"col-xl-5\">\r\n        <div style=\"min-height: 480px\">\r\n          <h3>{{ product.name }}</h3>\r\n          <h1 class=\"text-red\">\r\n            {{ this.$common.formatTablePrice(product.price) }}\r\n          </h1>\r\n          <ul class=\"text-xl text-black\">\r\n            <li><strong>Kích thước(DxRxC cm): </strong>{{ product.size }}</li>\r\n            <li><strong>Công suất: </strong>{{ product.capacity }}W</li>\r\n            <li><strong>Hãng: </strong>{{ product.manufacturer }}</li>\r\n            <li>\r\n              <strong>Loại sản phẩm: </strong>{{ product.productTypeName }}\r\n            </li>\r\n            <li><strong>Bảo hành: </strong>{{ product.warrantyPeriod }}</li>\r\n            <div v-for=\"(item, index) in product.infoProduct\" :key=\"index\">\r\n              <li>\r\n                <strong>{{ item.name }}: </strong>{{ item.describe }}\r\n              </li>\r\n            </div>\r\n          </ul>\r\n        </div>\r\n        <v-btn\r\n          class=\"custom-button\"\r\n          color=\"#4ec3f7\"\r\n          size=\"large\"\r\n          variant=\"flat\"\r\n          @click=\"btnAdvise()\"\r\n        >\r\n          <strong>TƯ VẤN</strong>\r\n        </v-btn>\r\n      </BCol>\r\n    </BRow>\r\n  </div>\r\n  <BCard>\r\n    <BCardHeader class=\"p-0\">\r\n      <h3>Sản phẩm tương tự</h3>\r\n    </BCardHeader>\r\n    <BCardBody class=\"pl-0 pr-0\">\r\n      <v-slide-group v-model=\"model\" show-arrows>\r\n        <v-slide-group-item\r\n          v-for=\"(item, index) in SimilarProducts\"\r\n          :key=\"index\"\r\n        >\r\n          <div class=\"item mx-1\" @click=\"GotoDetail(item.id)\">\r\n            <div class=\"d-flex w-100 justify-center\">\r\n              <img :src=\"item.pathImg\" width=\"280px\" height=\"280px\" alt=\"\" />\r\n            </div>\r\n            <div class=\"text-center mt-3\">\r\n              <p style=\"font-size: 18px !important\">{{ item.name }}</p>\r\n              <h3 style=\"color: red\" class=\"text\">\r\n                {{ item.price.toLocaleString(\"vi-vn\") }} VNĐ\r\n              </h3>\r\n            </div>\r\n          </div>\r\n        </v-slide-group-item>\r\n      </v-slide-group>\r\n    </BCardBody>\r\n  </BCard>\r\n  <vue-easy-lightbox\r\n    :visible=\"visible\"\r\n    :imgs=\"product.pathImg\"\r\n    :index=\"index\"\r\n    @hide=\"handleHide\"\r\n  ></vue-easy-lightbox>\r\n  <BModal\r\n    v-model=\"ViewAdvise\"\r\n    hide-footer\r\n    title=\"Thông tin liên hệ\"\r\n    modal-class=\"fadeInRight\"\r\n    centered\r\n    size=\"lg\"\r\n  >\r\n    <div class=\"card-body\">\r\n      <v-form v-model=\"form\" ref=\"form\">\r\n        <BRow class=\"d-flex align-items-start\">\r\n          <!-- Hình ảnh sản phẩm -->\r\n          <BCol lg=\"6\" md=\"12\" class=\"product\">\r\n            <div class=\"card d-flex align-center\" style=\"width: 100%\">\r\n              <img\r\n                class=\"card-img-top mt-3\"\r\n                :src=\"product.pathImg[0]\"\r\n                alt=\"Card image\"\r\n                style=\"width: 300px; height: 300px\"\r\n              />\r\n              <div class=\"card-body\">\r\n                <p class=\"card-text\">{{ product.name }}</p>\r\n                <h3 class=\"text-red\">\r\n                  {{ product.price.toLocaleString(\"vi-vn\") }} VNĐ\r\n                </h3>\r\n              </div>\r\n            </div>\r\n            <h5>Bạn vui lòng nhập đúng số điện thoại để chúng tôi sẽ gọi xác nhận đơn hàng trước khi giao hàng. Xin cảm ơn!</h5>\r\n          </BCol>\r\n\r\n          <!-- Form nhập thông tin (bên phải thẻ card) -->\r\n          <BCol lg=\"6\" md=\"12\">\r\n            <div class=\"form-container\">\r\n              <div class=\"form-group m-0\">\r\n                <label class=\"form-label\">Họ và tên*:</label>\r\n                <v-text-field\r\n                  v-model=\"Advise.customerName\"\r\n                  :rules=\"[rules.required]\"\r\n                  variant=\"outlined\"\r\n                  clearable\r\n                  placeholder=\"Nhập họ và tên\"\r\n                  density=\"compact\"\r\n                />\r\n              </div>\r\n                <v-radio-group v-model=\"Advise.gender\">\r\n                    <div class=\"d-flex justify-space-evenly align-items-center\">\r\n                            <div class=\"text-body-1 font-weight-bold\">Giới tính</div>\r\n                            <div>\r\n                                <v-radio label=\"Nam\" :value=\"1\"></v-radio>\r\n                            </div>\r\n                            <div>\r\n                                <v-radio label=\"Nữ\" :value=\"0\"></v-radio>\r\n                            </div>\r\n                    </div>\r\n                </v-radio-group>\r\n              <div class=\"form-group m-0\">\r\n                <label class=\"form-label\">Số điện thoại*:</label>\r\n                <v-text-field\r\n                  v-model=\"Advise.sDTCustomer\"\r\n                  :rules=\"[rules.validPhone]\"\r\n                  variant=\"outlined\"\r\n                  clearable\r\n                  placeholder=\"Nhập số điện thoại\"\r\n                  density=\"compact\"\r\n                />\r\n              </div>\r\n\r\n              <div class=\"form-group m-0\">\r\n                <label class=\"form-label\">Email:</label>\r\n                <v-text-field\r\n                  v-model=\"Advise.email\"\r\n                  variant=\"outlined\"\r\n                  clearable\r\n                  placeholder=\"Nhập email\"\r\n                  density=\"compact\"\r\n                />\r\n              </div>\r\n\r\n              <div class=\"form-group m-0\">\r\n                <label class=\"form-label\">Địa chỉ nhận hàng:</label>\r\n                <v-text-field\r\n                  v-model=\"Advise.address\"\r\n                  variant=\"outlined\"\r\n                  clearable\r\n                  placeholder=\"Nhập địa chỉ\"\r\n                  density=\"compact\"\r\n                />\r\n              </div>\r\n\r\n              <div class=\"form-group m-0\">\r\n                <label class=\"form-label\">Ghi chú thêm:</label>\r\n                <v-textarea\r\n                  v-model=\"Advise.note\"\r\n                  variant=\"outlined\"\r\n                  clearable\r\n                  placeholder=\"Nhập ghi chú\"\r\n                  density=\"compact\"\r\n                  rows=\"3\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </BCol>\r\n        </BRow>\r\n      </v-form>\r\n    </div>\r\n    <div class=\"modal-footer v-modal-footer\">\r\n      <BButton type=\"button\" variant=\"light\" @click=\"ViewAdvise = false\"\r\n        >Close\r\n      </BButton>\r\n      <BButton type=\"button\" variant=\"primary\" @click=\"SaveAdvise()\" :disabled=\"!form\">Đặt hàng ngay</BButton\r\n      >\r\n    </div>\r\n  </BModal>\r\n</template>\r\n<style scoped>\r\n.thumbnail-container {\r\n  cursor: pointer;\r\n  padding: 4px;\r\n}\r\n\r\n.thumbnail {\r\n  border: 2px solid transparent;\r\n  border-radius: 8px;\r\n  transition: 0.3s;\r\n}\r\n\r\n.thumbnail.active {\r\n  border-color: #1976d2; /* Màu xanh Vuetify */\r\n  box-shadow: 0 0 8px rgba(25, 118, 210, 0.7);\r\n}\r\n\r\n.thumbnail {\r\n  width: 50px;\r\n  height: 50px;\r\n}\r\n.custom-button {\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n  color: white !important;\r\n  text-transform: none; /* Giữ nguyên chữ thường */\r\n  border-radius: 8px; /* Bo góc nhẹ */\r\n}\r\n.item {\r\n  width: 25% !important;\r\n}\r\nimg:hover {\r\n  transform: scale(1.05);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  img {\r\n    height: 120px; /* Khi màn hình nhỏ hơn 768px */\r\n    width: 120px;\r\n  }\r\n  .text {\r\n    font-size: 15px;\r\n  }\r\n  .item {\r\n    width: 50% !important;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AACA,OAAOA,UAAS,MAAO,8BAA8B;AACrD,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE,CAAC;MACfC,OAAO,EAAE;QACP;QACAJ,IAAI,EAAE,IAAI;QACVK,OAAO,EAAE,EAAE;QACXC,KAAK,EAAE,CAAC;QACRC,WAAW,EAAE;MACf,CAAC;MACDC,eAAe,EAAE,EAAE;MAAE;MACrBC,MAAM,EAAE;QACN;QACAC,YAAY,EAAE,IAAI;QAClBC,WAAW,EAAE,IAAI;QACjBC,OAAO,EAAE,IAAI;QACbC,KAAK,EAAE,IAAI;QACXC,IAAI,EAAE,IAAI;QACVC,SAAS,EAAE,IAAI;QACfC,MAAM,EAAE;MACV,CAAC;MACDC,KAAK,EAAE,CAAC;MACRC,OAAO,EAAE,KAAK;MACdC,KAAK,EAAE,IAAI;MACXC,UAAU,EAAE,KAAK;MACjBC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMP,SAAQ,GAAI,IAAI,CAACQ,MAAM,CAACC,MAAM,CAACT,SAAS;IAC9C,IAAI,CAACU,SAAS,CAACV,SAAS,CAAC;EAC3B,CAAC;EACDW,OAAO,EAAE;IACPD,SAASA,CAACE,EAAE,EAAE;MACZ,IAAI,CAACC,UAAU,CAACC,GAAG,CAAC,sBAAsBF,EAAE,EAAE,CAAC,CAACG,IAAI,CAAEC,QAAQ,IAAK;QACjE,IAAI,CAAC3B,OAAM,GAAI2B,QAAQ,CAAC7B,IAAI;QAC5B,IAAI,CAAC0B,UAAS,CACXC,GAAG,CACF,yCAAyC,IAAI,CAACzB,OAAO,CAAC4B,aAAa,OAAOL,EAAE,EAC9E,EACCG,IAAI,CAAEC,QAAQ,IAAK;UAClB,IAAI,CAACvB,eAAc,GAAIuB,QAAQ,CAAC7B,IAAI;QACtC,CAAC,CAAC;MACN,CAAC,CAAC;IACJ,CAAC;IACD+B,OAAOA,CAAChB,KAAK,EAAE;MACb,IAAI,CAACA,KAAI,GAAIA,KAAK;MAClB,IAAI,CAACC,OAAM,GAAI,IAAI;IACrB,CAAC;IACDgB,UAAUA,CAAA,EAAG;MACX,IAAI,CAAChB,OAAM,GAAI,KAAK;IACtB,CAAC;IACDiB,UAAUA,CAACC,EAAE,EAAE;MACb,IAAI,CAACC,OAAO,CAACC,OAAO,CAAC;QACnBtC,IAAI,EAAE,IAAI,CAACuB,MAAM,CAACvB,IAAI;QACtBwB,MAAM,EAAE;UAAET,SAAS,EAAEqB;QAAG;MAC1B,CAAC,CAAC;MACF,IAAI,CAACX,SAAS,CAACW,EAAE,CAAC;MAClBG,MAAM,CAACC,QAAQ,CAAC;QAAEC,GAAG,EAAE,CAAC;QAAEC,QAAQ,EAAE;MAAS,CAAC,CAAC,EAAE;IACnD,CAAC;IACDC,SAASA,CAAA,EAAG;MACV,IAAI,CAACvB,UAAS,GAAI,CAAC,IAAI,CAACA,UAAU;MAClC,IAAI,CAACX,MAAK,GAAI;QACZC,YAAY,EAAE,IAAI;QAClBC,WAAW,EAAE,IAAI;QACjBC,OAAO,EAAE,IAAI;QACbI,MAAM,EAAE,CAAC;QACTD,SAAS,EAAE,IAAI,CAACX,OAAO,CAACgC;MAC1B,CAAC;IACH,CAAC;IACDQ,UAAUA,CAAA,EAAG;MACXC,OAAO,CAACC,GAAG,CAAC,IAAI,CAACrC,MAAM,CAAC;MACxB,IAAI,CAACmB,UAAU,CAACmB,IAAI,CAAC,eAAe,EAAE,IAAI,CAACtC,MAAM,CAAC,CAACqB,IAAI,CAAC,MAAM;QAC5D,IAAI,CAACkB,OAAO,CACV,qBAAqB,EACrB,0DAA0D,EAC1D,SACF,CAAC;QACD,IAAI,CAAC5B,UAAS,GAAI,KAAK;MACzB,CAAC,CAAC;IACJ;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}