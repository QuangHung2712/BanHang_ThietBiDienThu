{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.reduce.js\";\nexport default {\n  name: \"ShoppingPage\",\n  data() {\n    return {\n      products: [{\n        name: \"Tủ Bàn Mát Salad GoldCool 15 Khay 1/6 1.5M\",\n        price: 16000000,\n        quantity: 3,\n        image: \"https://goldcool.vn/wp-content/uploads/2023/05/tu-salad-300x300.jpg\"\n      }, {\n        name: \"Tủ Bàn Mát Salad GoldCool 8 Khay 1/2 1.8M\",\n        price: 17000000,\n        quantity: 1,\n        image: \"https://goldcool.vn/wp-content/uploads/2023/05/tu-salad-300x300.jpg\"\n      }],\n      discountCode: \"\"\n    };\n  },\n  computed: {\n    totalPrice() {\n      return this.products.reduce((sum, product) => sum + product.price * product.quantity, 0);\n    }\n  },\n  created() {\n    this.GetData();\n  },\n  methods: {\n    formatPrice(value) {\n      return new Intl.NumberFormat(\"vi-VN\", {\n        style: \"currency\",\n        currency: \"VND\"\n      }).format(value);\n    },\n    GetData() {\n      let infoData = this.$common.loadProductsFromCookie();\n      console.log(this.products);\n      this.$apiClient.post(`/Product/GetAllProductById`, infoData).then(response => {\n        this.products = response.data;\n      });\n    },\n    increaseQuantity(index) {\n      this.products[index].quantity++;\n    },\n    decreaseQuantity(index) {\n      if (this.products[index].quantity > 1) {\n        this.products[index].quantity--;\n      }\n    },\n    removeProduct(index) {\n      this.products.splice(index, 1);\n    },\n    checkout() {\n      // Lưu giỏ hàng vào LocalStorage\n      localStorage.setItem(\"cart\", JSON.stringify(this.products));\n\n      // Lưu tổng tiền\n      localStorage.setItem(\"totalPrice\", this.totalPrice);\n\n      // Chuyển hướng sang trang thanh toán\n      this.$router.push(\"checkout\");\n    }\n  }\n};","map":{"version":3,"names":["name","data","products","price","quantity","image","discountCode","computed","totalPrice","reduce","sum","product","created","GetData","methods","formatPrice","value","Intl","NumberFormat","style","currency","format","infoData","$common","loadProductsFromCookie","console","log","$apiClient","post","then","response","increaseQuantity","index","decreaseQuantity","removeProduct","splice","checkout","localStorage","setItem","JSON","stringify","$router","push"],"sources":["D:\\Du_An\\BanHang_ThietBiDienThu\\QLBH_Application\\src\\views\\SearchForProducts\\ProductCart.vue"],"sourcesContent":["<template style=\"min-height: auto\">\r\n    <div style=\"height: 50px\"></div>\r\n    <div class=\"shopping-page container\">\r\n      <div class=\"row\">\r\n        <!-- Danh sách sản phẩm -->\r\n        <div\r\n          class=\"lstProduct col-lg-7 col-12\"\r\n          style=\"margin-right: 50px; margin-bottom: 50px\"\r\n        >\r\n          <div class=\"header row font-weight-bold border-bottom pb-2 mb-2\">\r\n            <div class=\"col-6 d-flex justify-content-center\">Sản phẩm</div>\r\n  \r\n            <div class=\"col-2\">Giá</div>\r\n            <div class=\"col-2\">Số lượng</div>\r\n            <div class=\"col-2\">Tạm tính</div>\r\n          </div>\r\n          <div class=\"product-list\">\r\n            <div\r\n              v-for=\"(product, index) in products\"\r\n              :key=\"index\"\r\n              class=\"product-item row align-items-center\"\r\n            >\r\n              <div class=\"col-1\">\r\n                <button @click=\"removeProduct(index)\" class=\"btn btn-danger\">\r\n                  x\r\n                </button>\r\n              </div>\r\n              <div class=\"col-2\">\r\n                <img :src=\"product.image\" alt=\"product\" class=\"img-fluid\" />\r\n              </div>\r\n              <div class=\"col-3\">{{ product.name }}</div>\r\n              <div\r\n                class=\"col-2 text-danger\"\r\n                style=\"font-weight: bold; font-size: 1.2em\"\r\n              >\r\n                {{ formatPrice(product.price) }}\r\n              </div>\r\n              <div class=\"col-2 d-flex align-items-center justify-content-center\">\r\n                <button @click=\"decreaseQuantity(index)\" class=\"quantity-btn\">\r\n                  -\r\n                </button>\r\n                <span class=\"mx-2 quantity-text\">{{ product.quantity }}</span>\r\n                <button @click=\"increaseQuantity(index)\" class=\"quantity-btn\">\r\n                  +\r\n                </button>\r\n              </div>\r\n              <div\r\n                class=\"col-2 text-danger\"\r\n                style=\"font-weight: bold; font-size: 1.2em\"\r\n              >\r\n                {{ formatPrice(product.price * product.quantity) }}\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n  \r\n        <!-- Thanh toán -->\r\n        <div class=\"thanhtoan col-lg-4 col-10\">\r\n          <div class=\"thanhtoandetail p-4 border rounded\">\r\n            <h5 class=\"border-bottom pb-2\">TỔNG CỘNG GIỎ HÀNG</h5>\r\n            <div class=\"total d-flex justify-content-between\">\r\n              <span>Tạm tính:</span>\r\n              <span\r\n                class=\"text-danger\"\r\n                style=\"font-weight: bold; font-size: 1.1em\"\r\n                >{{ formatPrice(totalPrice) }}</span\r\n              >\r\n            </div>\r\n            <div class=\"sum d-flex justify-content-between mt-2\">\r\n              <span>Tổng:</span>\r\n              <span\r\n                class=\"text-danger\"\r\n                style=\"font-weight: bold; font-size: 1.2em\"\r\n                >{{ formatPrice(totalPrice) }}</span\r\n              >\r\n            </div>\r\n            <button class=\"btn w-100 mt-3 custom-btn\" @click=\"checkout\">\r\n              TIẾN HÀNH THANH TOÁN\r\n            </button>\r\n          </div>\r\n          <div class=\"saleCODE mt-3 p-3 border rounded\">\r\n            <label class=\"font-weight-bold\">Mã ưu đãi</label>\r\n            <input\r\n              v-model=\"discountCode\"\r\n              type=\"text\"\r\n              placeholder=\"Mã ưu đãi\"\r\n              class=\"form-control mt-1\"\r\n            />\r\n            <button class=\"btn w-100 mt-3 custom-btn\">Áp dụng</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <BCard style=\"margin-top: 100px\">\r\n        <BCardHeader class=\"p-0\">\r\n          <h3>Sản phẩm tương tự</h3>\r\n        </BCardHeader>\r\n        <BCardBody class=\"pl-0 pr-0\">\r\n          <v-slide-group v-model=\"model\" show-arrows class=\"pb-4\">\r\n            <v-slide-group-item\r\n              v-for=\"(itemProduct, indexProduct) in SimilarProducts\"\r\n              :key=\"indexProduct\"\r\n            >\r\n              <a\r\n                @click=\"GotoDetail(itemProduct.id)\"\r\n                target=\"_blank\"\r\n                class=\"product-card item m-2 my-3\"\r\n              >\r\n                <div>\r\n                  <img :src=\"itemProduct.pathImg\" alt=\"product\" />\r\n                </div>\r\n                <div class=\"product-name\">{{ itemProduct.name }}</div>\r\n                <h4 style=\"color: red\" class=\"text m-0\">\r\n                  {{ itemProduct.price.toLocaleString(\"vi-vn\") }} VNĐ\r\n                </h4>\r\n              </a>\r\n            </v-slide-group-item>\r\n          </v-slide-group>\r\n        </BCardBody>\r\n      </BCard>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    name: \"ShoppingPage\",\r\n    data() {\r\n      return {\r\n        products: [\r\n          {\r\n            name: \"Tủ Bàn Mát Salad GoldCool 15 Khay 1/6 1.5M\",\r\n            price: 16000000,\r\n            quantity: 3,\r\n            image:\r\n              \"https://goldcool.vn/wp-content/uploads/2023/05/tu-salad-300x300.jpg\",\r\n          },\r\n          {\r\n            name: \"Tủ Bàn Mát Salad GoldCool 8 Khay 1/2 1.8M\",\r\n            price: 17000000,\r\n            quantity: 1,\r\n            image:\r\n              \"https://goldcool.vn/wp-content/uploads/2023/05/tu-salad-300x300.jpg\",\r\n          },\r\n        ],\r\n        discountCode: \"\",\r\n      };\r\n    },\r\n    computed: {\r\n      totalPrice() {\r\n        return this.products.reduce(\r\n          (sum, product) => sum + product.price * product.quantity,\r\n          0\r\n        );\r\n      },\r\n    },\r\n    created(){\r\n      this.GetData();\r\n    },\r\n    methods: {\r\n      formatPrice(value) {\r\n        return new Intl.NumberFormat(\"vi-VN\", {\r\n          style: \"currency\",\r\n          currency: \"VND\",\r\n        }).format(value);\r\n      },\r\n      GetData(){\r\n        let infoData = this.$common.loadProductsFromCookie();\r\n        console.log(this.products)\r\n        this.$apiClient.post(`/Product/GetAllProductById`,infoData)\r\n            .then((response) => {\r\n              this.products = response.data\r\n            })\r\n      },\r\n      increaseQuantity(index) {\r\n        this.products[index].quantity++;\r\n      },\r\n      decreaseQuantity(index) {\r\n        if (this.products[index].quantity > 1) {\r\n          this.products[index].quantity--;\r\n        }\r\n      },\r\n      removeProduct(index) {\r\n        this.products.splice(index, 1);\r\n      },\r\n      checkout() {\r\n        // Lưu giỏ hàng vào LocalStorage\r\n        localStorage.setItem(\"cart\", JSON.stringify(this.products));\r\n  \r\n        // Lưu tổng tiền\r\n        localStorage.setItem(\"totalPrice\", this.totalPrice);\r\n  \r\n        // Chuyển hướng sang trang thanh toán\r\n        this.$router.push(\"checkout\");\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .custom-btn {\r\n    background-color: #1eb8ff; /* Màu cam */\r\n    color: white;\r\n    border: none;\r\n  }\r\n  \r\n  .custom-btn:hover {\r\n    background-color: #b4e7ff; /* Màu cam đậm hơn khi hover */\r\n  }\r\n  \r\n  .product-item {\r\n    border-bottom: 1px solid #ddd;\r\n    padding: 10px 0;\r\n  }\r\n  button {\r\n    border: none;\r\n    background: #ddd;\r\n    border-radius: 5px;\r\n    width: 20px;\r\n    height: 30px;\r\n    padding: 5px 5px;\r\n    cursor: pointer;\r\n  }\r\n  .btn-danger {\r\n    background: transparent;\r\n    color: rgb(118, 118, 118);\r\n    border: 2px solid rgb(133, 133, 133);\r\n    border-radius: 50%;\r\n    width: 30px;\r\n    height: 30px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 0;\r\n  }\r\n  .thanhtoandetail {\r\n    background: #f8f9fa;\r\n    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\r\n  }\r\n  .saleCODE {\r\n    background: #ffffff;\r\n    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\r\n  }\r\n  </style>\r\n  "],"mappings":";;;AA2HE,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,CACR;QACEF,IAAI,EAAE,4CAA4C;QAClDG,KAAK,EAAE,QAAQ;QACfC,QAAQ,EAAE,CAAC;QACXC,KAAK,EACH;MACJ,CAAC,EACD;QACEL,IAAI,EAAE,2CAA2C;QACjDG,KAAK,EAAE,QAAQ;QACfC,QAAQ,EAAE,CAAC;QACXC,KAAK,EACH;MACJ,CAAC,CACF;MACDC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,OAAO,IAAI,CAACN,QAAQ,CAACO,MAAM,CACzB,CAACC,GAAG,EAAEC,OAAO,KAAKD,GAAE,GAAIC,OAAO,CAACR,KAAI,GAAIQ,OAAO,CAACP,QAAQ,EACxD,CACF,CAAC;IACH;EACF,CAAC;EACDQ,OAAOA,CAAA,EAAE;IACP,IAAI,CAACC,OAAO,CAAC,CAAC;EAChB,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAACC,KAAK,EAAE;MACjB,OAAO,IAAIC,IAAI,CAACC,YAAY,CAAC,OAAO,EAAE;QACpCC,KAAK,EAAE,UAAU;QACjBC,QAAQ,EAAE;MACZ,CAAC,CAAC,CAACC,MAAM,CAACL,KAAK,CAAC;IAClB,CAAC;IACDH,OAAOA,CAAA,EAAE;MACP,IAAIS,QAAO,GAAI,IAAI,CAACC,OAAO,CAACC,sBAAsB,CAAC,CAAC;MACpDC,OAAO,CAACC,GAAG,CAAC,IAAI,CAACxB,QAAQ;MACzB,IAAI,CAACyB,UAAU,CAACC,IAAI,CAAC,4BAA4B,EAACN,QAAQ,EACrDO,IAAI,CAAEC,QAAQ,IAAK;QAClB,IAAI,CAAC5B,QAAO,GAAI4B,QAAQ,CAAC7B,IAAG;MAC9B,CAAC;IACP,CAAC;IACD8B,gBAAgBA,CAACC,KAAK,EAAE;MACtB,IAAI,CAAC9B,QAAQ,CAAC8B,KAAK,CAAC,CAAC5B